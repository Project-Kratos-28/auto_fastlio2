<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kratos_bringup</name>
  <version>0.1.0</version>
  <description>One-command bring-up of the Kratos rover stack on the Orin: MID-360 driver, angle filter, GLIM, pcd2pgm, Nav2 (+ nvblox_layer), ZED 2i depth + nvblox, RViz.</description>
  <maintainer email="advaithm.nair@gmail.com">Advaith</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>lidar_angle_filter</exec_depend>
  <exec_depend>glim_ros</exec_depend>
  <exec_depend>pcd2pgm</exec_depend>
  <exec_depend>kratos_nav</exec_depend>
  <exec_depend>kratos_perception</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nvblox_rviz_plugin</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
