# kratos_bringup laptop RViz: only topics that are cheap over the radio link (/map, costmaps,
# TF, /plan, GLIM odometry). No point clouds, images or meshes. Works in Humble and Jazzy RViz.
#   rviz2 -d <repo>/src/kratos_bringup/rviz/laptop.rviz
Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Tool Properties
  Name: Tool Properties
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Reference Frame: map
    Cell Size: 1.0
    Plane Cell Count: 50
    Color: 160; 160; 164
    Alpha: 0.3
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Marker Scale: 0.5
    Frames:
      All Enabled: false
      map:
        Value: true
      odom:
        Value: true
      base_link:
        Value: true
  - Class: rviz_default_plugins/Map
    Name: Map (pcd2pgm /map)
    Enabled: true
    Alpha: 0.6
    Color Scheme: map
    Topic:
      Value: /map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: false
    Alpha: 0.4
    Color Scheme: costmap
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Map
    Name: Local costmap (LiDAR + nvblox)
    Enabled: true
    Alpha: 0.7
    Color Scheme: costmap
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/Path
    Name: Plan
    Enabled: true
    Color: 25; 255; 0
    Topic:
      Value: /plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  - Class: rviz_default_plugins/Odometry
    Name: GLIM odometry
    Enabled: true
    Keep: 200
    Shape:
      Value: Arrow
    Covariance:
      Value: false
    Topic:
      Value: /glim_ros/odom
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 15
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Target Frame: base_link
      Scale: 40
Window Geometry:
  Width: 1400
  Height: 900
