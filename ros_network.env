# ROS 2 networking for the kratos_glim container (read by docker/run_container.sh when the
# container starts: restart it after editing, `./stop.sh` then `./start.sh`).
#
# The rover is driven from a laptop over the Ubiquiti link, so ROS must be visible on the network.
# Set ROS_DOMAIN_ID to the SAME number as on the laptop (0 if the laptop does not set it).
ROS_DOMAIN_ID=0
# SUBNET: discover nodes on the local network (the laptop). LOCALHOST would hide the rover.
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
# Same DDS implementation on both sides (Fast DDS is the default in Humble and Jazzy).
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# If the laptop does not show the rover's nodes (the radio link drops the multicast DDS uses
# for discovery), put the laptop's IP here: discovery then also goes by unicast.
# ROS_STATIC_PEERS=192.168.1.20
